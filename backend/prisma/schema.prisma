generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Users ────────────────────────────────────────────────────────────────────

model User {
  id        Int      @id @default(autoincrement())
  name      String
  username  String   @unique
  password  String
  role      Role     @default(STAFF)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

enum Role {
  ADMIN
  STAFF
}

// ─── Companies ────────────────────────────────────────────────────────────────

model Company {
  id          Int              @id @default(autoincrement())
  companyName String           @unique
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  purchases   PurchaseMaster[]

  @@map("companies")
}

// ─── Purchase ─────────────────────────────────────────────────────────────────

model PurchaseMaster {
  id           Int            @id @default(autoincrement())
  purchaseDate DateTime       @db.Date
  invoiceNo    String?
  companyId    Int
  company      Company        @relation(fields: [companyId], references: [id])
  totalAmount  Decimal        @db.Decimal(12, 2)
  note         String?
  createdAt    DateTime       @default(now())
  items        PurchaseItem[]

  @@map("purchase_master")
}

model PurchaseItem {
  id          Int            @id @default(autoincrement())
  purchaseId  Int
  purchase    PurchaseMaster @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productName String
  quantity    Decimal        @db.Decimal(12, 2)
  unitPrice   Decimal        @db.Decimal(12, 2)
  amount      Decimal        @db.Decimal(12, 2)

  @@map("purchase_items")
}

// ─── Expense ──────────────────────────────────────────────────────────────────

model ExpenseCategory {
  id           Int       @id @default(autoincrement())
  categoryName String    @unique
  isActive     Boolean   @default(true)
  expenses     Expense[]

  @@map("expense_categories")
}

model Expense {
  id             Int             @id @default(autoincrement())
  expenseDate    DateTime        @db.Date
  categoryId     Int
  category       ExpenseCategory @relation(fields: [categoryId], references: [id])
  amount         Decimal         @db.Decimal(12, 2)
  note           String?
  createdAt      DateTime        @default(now())
  salaryPayments SalaryPayment[]

  @@map("expenses")
}

// ─── Cash Transactions ────────────────────────────────────────────────────────

model TransactionType {
  id                   Int               @id @default(autoincrement())
  transactionName      String            @unique
  transactionDirection Direction
  isActive             Boolean           @default(true)
  transactions         CashTransaction[]

  @@map("transaction_types")
}

enum Direction {
  IN
  OUT
}

model CashTransaction {
  id                Int             @id @default(autoincrement())
  transactionDate   DateTime        @db.Date
  transactionTypeId Int
  transactionType   TransactionType @relation(fields: [transactionTypeId], references: [id])
  amount            Decimal         @db.Decimal(12, 2)
  note              String?
  createdAt         DateTime        @default(now())

  @@map("cash_transactions")
}

// ─── Daily Accounts ───────────────────────────────────────────────────────────

model DailyAccount {
  id             Int      @id @default(autoincrement())
  accountDate    DateTime @unique @db.Date
  openingBalance Decimal  @db.Decimal(12, 2)
  purchaseAmount Decimal  @db.Decimal(12, 2) @default(0)
  expenseAmount  Decimal  @db.Decimal(12, 2) @default(0)
  cashInAmount   Decimal  @db.Decimal(12, 2) @default(0)
  cashOutAmount  Decimal  @db.Decimal(12, 2) @default(0)
  closingBalance Decimal  @db.Decimal(12, 2)
  salesAmount    Decimal  @db.Decimal(12, 2) @default(0)
  profitAmount   Decimal  @db.Decimal(12, 2) @default(0)
  createdAt      DateTime @default(now())

  @@map("daily_accounts")
}

// ─── HR Module ────────────────────────────────────────────────────────────────

model Employee {
  id             Int             @id @default(autoincrement())
  name           String
  phone          String?
  address        String?
  position       String?
  joinDate       DateTime        @db.Date
  basicSalary    Decimal         @db.Decimal(12, 2) @default(0)
  workingHours   Decimal         @db.Decimal(4, 2) @default(8)
  overtimeRate   Decimal         @db.Decimal(12, 2) @default(0)
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  attendance     Attendance[]
  salaryPayments SalaryPayment[]
  timeEntries    TimeEntry[]

  @@map("employees")
}

model Attendance {
  id             Int              @id @default(autoincrement())
  employeeId     Int
  employee       Employee         @relation(fields: [employeeId], references: [id])
  attendanceDate DateTime         @db.Date
  status         AttendanceStatus @default(PRESENT)
  note           String?
  createdAt      DateTime         @default(now())

  @@unique([employeeId, attendanceDate])
  @@map("attendance")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  HOLIDAY
  LEAVE
}

model SalaryPayment {
  id          Int         @id @default(autoincrement())
  employeeId  Int
  employee    Employee    @relation(fields: [employeeId], references: [id])
  paymentDate DateTime    @db.Date
  paymentType PaymentType
  amount      Decimal     @db.Decimal(12, 2)
  month       Int?
  year        Int?
  note        String?
  expenseId   Int?
  expense     Expense?    @relation(fields: [expenseId], references: [id])
  createdAt   DateTime    @default(now())

  @@map("salary_payments")
}

enum PaymentType {
  SALARY
  BONUS
  PARTIAL
}

model TimeEntry {
  id            Int      @id @default(autoincrement())
  employeeId    Int
  employee      Employee @relation(fields: [employeeId], references: [id])
  entryDate     DateTime @db.Date
  checkIn       String?
  checkOut      String?
  workHours     Decimal? @db.Decimal(5, 2)
  overtimeHours Decimal  @db.Decimal(5, 2) @default(0)
  note          String?
  createdAt     DateTime @default(now())

  @@unique([employeeId, entryDate])
  @@map("time_entries")
}
